{
  "layer": "top",
  "position": "top",
  "height": 26,
  "modules-left": [
    "custom/launcher",
    "sway/workspaces",
    "sway/mode"
  ],
  "modules-center": [
    "sway/window"
  ],
  "modules-right": [
    "battery",
    "pulseaudio",
    "pulseaudio#microphone",
    "network",
    "network#speed",
    "memory",
    "cpu",
    "temperature",
    "custom/keyboard-layout",
    "tray",
    "clock#date",
    "clock#time",
    "custom/power"
  ],

  "custom/launcher": {
    "format": "󱄅",
    "tooltip-format": "Open launcher",
    "on-click": "wofi --show drun -I"
  },

  "custom/power": {
    "format": "󰐥",
    "tooltip-format": "Open power menu",
    "on-click": "wlogout"
  },

  "sway/workspaces": {
    "all-outputs": false,
    "disable-scroll": true,
    "format": "{name}"
  },

  "sway/mode": {
    "format": "<span style=\"italic\">{}</span>",
    "tooltip": false
  },

  "sway/window": {
    "format": "{}",
    "max-length": 120,
    "rewrite": {
      "(.*) - Google Chrome": "  $1",
      "(.*) - Visual Studio Code": "  $1",
      "(.*)Alacritty": "  Terminal"
    }
  },

  "clock#time": {
    "interval": 1,
    "format": "{:%H:%M}",
    "tooltip": false
  },

  "clock#date": {
    "interval": 10,
    "format": "  {:%e %b %Y}",
    "tooltip-format": "{:%e %B %Y}"
  },

  "custom/keyboard-layout": {
    "exec": "swaymsg -t get_inputs | grep -m1 'xkb_active_layout_name' | cut -d '\"' -f4",
    "interval": 30,
    "format": "  {}",
    "tooltip": false
  },

  "cpu": {
    "interval": 5,
    "format": "  {usage}% ({load})",
    "tooltip-format": "CPU\nUsage: {usage}%\nLoad: {load}",
    "states": {
      "warning": 70,
      "critical": 90
    }
  },

  "memory": {
    "interval": 5,
    "format": "󰍛  {}%",
    "tooltip-format": "Memory\nUsed: {used:0.1f} GiB\nTotal: {total:0.1f} GiB",
    "states": {
      "warning": 70,
      "critical": 90
    }
  },

  "network": {
    "interval": 1,
    "format-wifi": "  {essid} ({signalStrength}%)",
    "format-ethernet": "  {ipaddr}/{cidr}",
    "format-disconnected": "  Disconnected",
    "tooltip-format": "{ifname}: {ipaddr}"
  },

  "network#speed": {
    "interval": 1,
    "format-wifi": " {bandwidthUpBits}   {bandwidthDownBits}",
    "format-ethernet": " {bandwidthUpBits}   {bandwidthDownBits}",
    "format-disconnected": "",
    "tooltip": false
  },

  "pulseaudio": {
    "format": "{icon}  {volume}%",
    "format-bluetooth": "{icon}  {volume}%",
    "format-muted": "",
    "tooltip-format": "{desc}  {volume}%",
    "tooltip-format-muted": "{desc}  muted",
    "format-icons": {
      "headphones": "",
      "handsfree": "",
      "headset": "",
      "phone": "",
      "portable": "",
      "car": "",
      "default": [
        "",
        ""
      ]
    },
    "on-click": "pavucontrol",
    "on-click-right": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    "scroll-step": 5
  },

  "pulseaudio#microphone": {
    "format": "{format_source}",
    "format-source": "  {volume}%",
    "format-source-muted": "",
    "tooltip-format": "{source_desc}  {volume}%",
    "tooltip-format-source-muted": "{source_desc}  muted",
    "on-click": "pavucontrol --tab=4",
    "on-click-right": "pactl set-source-mute @DEFAULT_SOURCE@ toggle",
    "scroll-step": 5
  },

  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon}  {capacity}%",
    "format-charging": "󰂄  {capacity}%",
    "format-plugged": "󰚥  {capacity}%",
    "tooltip-format": "Battery\n{timeTo}\n{power:0.1f}W draw",
    "format-icons": [
      "󰂎",
      "󰁺",
      "󰁻",
      "󰁼",
      "󰁽",
      "󰁾",
      "󰁿",
      "󰂀",
      "󰂁",
      "󰂂",
      "󰁹"
    ]
  },

  "temperature": {
    "critical-threshold": 80,
    "interval": 5,
    "format": "{icon} {temperatureC}°C",
    "tooltip-format": "Temperature\nCurrent: {temperatureC}°C\nCritical: {criticalTemperatureC}°C",
    "format-icons": [
      "",
      "",
      "",
      "",
      ""
    ],
    "tooltip": true
  },

  "tray": {
    "icon-size": 18,
    "spacing": 8
  }
}
