# Copy this file to ~/.config/sway/local/outputs.env and edit values locally.
#
# Discover output names from inside Sway with:
# swaymsg -t get_outputs -r | jq -r '.[] | select(.active) | "\(.name) \(.rect.width)x\(.rect.height)"'

# Regex used to detect laptop/internal displays.
# SWAY_INTERNAL_REGEX='^(eDP|LVDS)'

# Optional named profile loaded from ~/.config/sway/local/profiles/<name>.env
# SWAY_OUTPUT_PROFILE='desktop'

# Layout modes: auto, single, stack-vertical, stack-horizontal
# SWAY_OUTPUT_LAYOUT='auto'

# Force a specific primary output name instead of auto-detecting.
# SWAY_PRIMARY_OUTPUT='DP-1'
# SWAY_SECONDARY_OUTPUT='eDP-1'
# SWAY_PRIMARY_TRANSFORM='normal'
# SWAY_SECONDARY_TRANSFORM='90'
# For a horizontal layout, set each output's vertical position in pixels.
# SWAY_PRIMARY_Y='560'
# SWAY_SECONDARY_Y='0'

# Shared defaults.
# SWAY_SCALE='1'
# SWAY_SCALE_FILTER='nearest'
# SWAY_WORKSPACE_COUNT='10'
# SWAY_SECONDARY_WORKSPACES='8 9 10'

# Per-role overrides.
# SWAY_PRIMARY_MODE='5120x1440@120Hz'
# SWAY_PRIMARY_SCALE='1'
# SWAY_EXTERNAL_MODE='5120x1440@120Hz'
# SWAY_EXTERNAL_SCALE='1'
# SWAY_INTERNAL_MODE='1920x1200'
# SWAY_INTERNAL_SCALE='1.25'
