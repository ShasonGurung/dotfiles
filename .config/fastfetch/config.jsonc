{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "padding": {
            "top": 1,
            "left": 2,
            "right": 4
        }
    },
    "display": {
        "separator": "  "
    },
    "modules": [
        {
            "type": "custom",
            "format": "\u001b[38;5;240m╔═══════════════════════════════ overview ═══════════════════════════════╗"
        },
        {
            "type": "title",
            "keyWidth": 10
        },
        {
            "type": "os",
            "key": " os",
            "keyColor": "cyan"
        },
        {
            "type": "kernel",
            "key": "󰒋 kernel",
            "keyColor": "cyan"
        },
        {
            "type": "shell",
            "key": " shell",
            "keyColor": "cyan"
        },
        {
            "type": "packages",
            "key": "󰏖 pkgs",
            "keyColor": "cyan"
        },
        {
            "type": "custom",
            "format": "\u001b[38;5;240m╠═══════════════════════════════ desktop ════════════════════════════════╣"
        },
        {
            "type": "wm",
            "key": " wm",
            "keyColor": "blue"
        },
        {
            "type": "terminal",
            "key": " term",
            "keyColor": "blue"
        },
        {
            "type": "display",
            "key": "󰍹 display",
            "keyColor": "blue"
        },
        {
            "type": "theme",
            "key": "󰉼 theme",
            "keyColor": "blue"
        },
        {
            "type": "icons",
            "key": "󰀻 icons",
            "keyColor": "blue"
        },
        {
            "type": "wallpaper",
            "key": "󰸉 wallpaper",
            "keyColor": "blue"
        },
        {
            "type": "custom",
            "format": "\u001b[38;5;240m╠══════════════════════════════ hardware ════════════════════════════════╣"
        },
        {
            "type": "host",
            "key": "󰌢 host",
            "keyColor": "green"
        },
        {
            "type": "cpu",
            "key": "󰻠 cpu",
            "keyColor": "green"
        },
        {
            "type": "gpu",
            "key": "󰍛 gpu",
            "keyColor": "green"
        },
        {
            "type": "memory",
            "key": "󰍛 mem",
            "keyColor": "green"
        },
        {
            "type": "disk",
            "key": " disk",
            "keyColor": "green"
        },
        {
            "type": "battery",
            "key": "󰂄 batt",
            "keyColor": "green"
        },
        {
            "type": "uptime",
            "key": "󰅐 up",
            "keyColor": "green"
        },
        {
            "type": "custom",
            "format": "\u001b[38;5;240m╠═══════════════════════════════ media ══════════════════════════════════╣"
        },
        {
            "type": "sound",
            "key": " audio",
            "keyColor": "magenta"
        },
        {
            "type": "player",
            "key": "󰥠 player",
            "keyColor": "magenta"
        },
        {
            "type": "media",
            "key": "󰝚 media",
            "keyColor": "magenta"
        },
        {
            "type": "custom",
            "format": "\u001b[38;5;240m╚════════════════════════════════════════════════════════════════════════╝"
        },
        "break",
        {
            "type": "colors",
            "paddingLeft": 2,
            "symbol": "circle"
        }
    ]
}
